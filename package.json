{
  "name": "thousand-paws-arcade",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter thousand-paws dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "tokens:report": "node scripts/token-lint.mjs",
    "tokens:check": "node scripts/token-lint.mjs --enforce"
  },
  "devDependencies": {
    "@paws/codemod": "https://github.com/aminchegini/pawprint-tokens/releases/download/v0.5.0/paws-codemod-0.5.0.tgz",
    "@paws/tokens": "https://github.com/aminchegini/pawprint-tokens/releases/download/v0.5.0/paws-tokens-0.5.0.tgz",
    "@playwright/test": "^1.64.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
